  },
  "misc": {
    "keyword_list": [
      "select",
      "union",
      "drop",
      "<script",
      "javascript:",
      "or '1'='1",
      "admin",
      "root"
    ],
    "auth_tokens": [
      "password",
      "passwd",
      "login failed",
      "invalid password",
      "invalid credentials",
      "failed login"
    ],
    "misconf_tokens": [
      "debug",
      "stacktrace",
      "exception",
      "traceback",
      "dump",
      "credentials"
    ],
    "dos_tokens": [
      "flood",
      "too many requests",
      "rate limit",
      "429",
      "timeout"
    ]
  },
  "unsafe_patterns": {
    "note": "These patterns are potentially ReDoS-prone or heavy — engine SHOULD NOT run them against long inputs. Use only when input length < RE_MAX_REGEX_INPUT_LEN or in controlled mode.",
    "patterns": [
      "(?i)^(?:([a-zA-Z]+)+)+$",
      "(?i)^(a+)+$",
      "(?i)([a-zA-Z]+)+.*\\1", 
      "(?i)(?:([0-9a-zA-Z])+)+\\1"
    ]
  }
}